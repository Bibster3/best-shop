  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "echo \"Dummy build script required for Autocode Compile\"",
    "compile:sass": "sass src/scss/main.scss dist/css/main.css",
    "watch:sass": "sass --watch src/scss/main.scss dist/css/main.css",
    "serve": "live-server --open=index.html --port=8080 --host=localhost",
    "dev": "npm-run-all --parallel watch:sass serve"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.77.4"
  }
}
